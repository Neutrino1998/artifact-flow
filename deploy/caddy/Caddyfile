# ArtifactFlow — Caddy entry config (Mode 2 / public deployment)
#
# Caddy terminates TLS (auto Let's Encrypt) and serves the shared site body
# from common.caddy (route order, maintenance gate, SSE flush, upload
# cap, X-Real-IP — all mode-agnostic mechanics live THERE, once, shared with
# the intranet entry config). This file only holds what is public-specific:
# ACME account + the AF_DOMAIN site address.
#
# Domain + ACME email come from the root .env (AF_DOMAIN / AF_ACME_EMAIL).
# Grey-cloud (CF "DNS only") assumed: clients connect directly, so {remote_host}
# IS the real client IP. If you later switch CF to orange-cloud (proxied), the
# real client moves into X-Forwarded-For and {remote_host} becomes Cloudflare's
# edge — add `trusted_proxies` (CF ranges) and switch to {client_ip}, else the
# per-IP login throttle degrades to one shared bucket.
{
	# ACME account email — Let's Encrypt sends cert-expiry warnings here as a
	# backstop. Caddy auto-renews ~30 days before expiry; you normally never act
	# on these mails.
	email {$AF_ACME_EMAIL}
}

import /etc/caddy/conf/upstreams.caddy
import /etc/caddy/conf/common.caddy

{$AF_DOMAIN} {
	import af_site
}

# Internal health listener for resume-prod.sh — see (af_health_probe) in
# common.caddy for the full rationale.
:2021 {
	import af_health_probe
}
