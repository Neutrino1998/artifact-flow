# Default single-host upstream targets. The Ansible executor renders this file
# inside the immutable release on the LB host for a multi-host topology;
# common.caddy keeps all timeout/retry/header policy shared between both forms.

(backend_upstream_targets) {
	dynamic a {
		name backend
		port 8000
		refresh 10s
	}
}

(frontend_upstream_targets) {
	to frontend:3000
}
