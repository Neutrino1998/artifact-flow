# ArtifactFlow autoheal — oneshot,由 .timer 周期触发。
# 安装:从已验收 release 显式安装脚本、本文件与 .timer，再执行
#   systemctl daemon-reload && systemctl enable --now artifactflow-autoheal.timer
# 详见 deploy/autoheal/README.md。
[Unit]
Description=ArtifactFlow autoheal — restart unhealthy containers
Documentation=file:deploy/autoheal/README.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/artifactflow
ExecStart=/opt/artifactflow/bin/artifactflow-autoheal
# 可选覆盖(默认见 autoheal.sh 头注释):
# Environment=AF_ROOT=/opt/artifactflow
# Environment=AUTOHEAL_SERVICES=backend frontend caddy
