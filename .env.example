# ========================================
# ArtifactFlow — Quick Trial (Mode 1)
# ========================================
# SQLite + InMemory RuntimeStore, no Redis required.
# Production/intranet targets use `afctl site init` and then edit
# `/opt/artifactflow/control/.env`; see docs/operations/first-deployment.md.

# ========================================
# LLM API Keys
# ========================================
DASHSCOPE_API_KEY=sk-xxx
# OPENAI_API_KEY=sk-xxx
# DEEPSEEK_API_KEY=sk-xxx
# GPUStack DeepSeek gateway (intranet branch)
GPUSTACK_DEEPSEEK_API_KEY=gpustack_xxx
# GPUSTACK_VISION_API_KEY=gpustack_xxx

# ========================================
# Tool API Keys
# ========================================
BOCHA_API_KEY=sk-xxx
# JINA_API_KEY=jina_xxx

# ========================================
# App (ARTIFACTFLOW_ prefix; operator reference: docs/configuration/runtime.md)
# ========================================
ARTIFACTFLOW_JWT_SECRET=       # python -c "import secrets; print(secrets.token_urlsafe(32))"
ARTIFACTFLOW_CREDENTIAL_KEY=   # python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  (required, even with no credentialed tools)
ARTIFACTFLOW_DATABASE_URL=sqlite+aiosqlite:///data/artifactflow.db
# ARTIFACTFLOW_DEBUG=true

# --- Common dev overrides (uncomment to use) ---
# ARTIFACTFLOW_EXECUTION_TIMEOUT=3600           # single turn ceiling (s)
# ARTIFACTFLOW_PERMISSION_TIMEOUT=300           # per-tool permission wait (s)
# ARTIFACTFLOW_LLM_CONNECT_TIMEOUT=5             # LLM DNS/TCP/TLS connect timeout (s)
# ARTIFACTFLOW_LLM_READ_TIMEOUT=600              # LLM first/next response chunk timeout (s)
# ARTIFACTFLOW_LLM_WRITE_TIMEOUT=60              # LLM request upload timeout (s)
# ARTIFACTFLOW_LLM_POOL_TIMEOUT=5                # LLM HTTP connection-pool wait (s)
# ARTIFACTFLOW_MCP_CONNECT_TIMEOUT=5             # MCP discovery/call connect timeout (s)
# ARTIFACTFLOW_MCP_WRITE_TIMEOUT=60              # MCP request upload timeout (s)
# ARTIFACTFLOW_MCP_POOL_TIMEOUT=5                # MCP HTTP connection-pool wait (s)
# ARTIFACTFLOW_COMPACTION_RESERVE_TOKENS=40000 # intranet: per-model trigger = context_window - reserve
# ARTIFACTFLOW_MAX_CONCURRENT_TASKS=32          # max concurrent engine executions
# ARTIFACTFLOW_MAX_UPLOAD_SIZE=209715200        # bytes, default 200MB
# ARTIFACTFLOW_SKILL_USER_MAX_PRIVATE_COUNT=3    # -1=unlimited, 0=disable personal imports
# ARTIFACTFLOW_MAX_BULK_IMPORT_ROWS=1000        # CSV bulk-import row cap
# ARTIFACTFLOW_MAX_BULK_IMPORT_BYTES=5242880    # CSV bulk-import byte cap (5MB)
# ARTIFACTFLOW_CORS_ORIGINS=["http://localhost:3000"]
